# hao.AI environment variables — template only. Never put real values here.
# Copy to .env.local for local dev; set real values in the Vercel dashboard.
# Each build unit appends the vars it introduces.

# --- Unit 1: DeepSeek (server-only, never NEXT_PUBLIC_) ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
