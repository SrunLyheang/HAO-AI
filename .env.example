# hao.AI environment variables — template only. Never put real values here.
# Copy to .env.local for local dev; set real values in the Vercel dashboard.
# Each build unit appends the vars it introduces.

# --- Unit 1: DeepSeek (server-only, never NEXT_PUBLIC_) ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- Unit 3: Groq Whisper, speech-to-text (server-only, never NEXT_PUBLIC_) ---
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo

# --- Unit 4: ElevenLabs TTS (server-only, never NEXT_PUBLIC_) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# --- Unit 6: Clerk auth (server-only except the publishable key) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Without these, Clerk falls back to redirecting through its hosted Account
# Portal (accounts.dev) instead of this app's own routes — both for the
# sign-in/sign-up pages themselves and for where a successful auth lands.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# --- Unit 7a: Neon Postgres + Drizzle (server-only) ---
DATABASE_URL=

# --- Unit 9: rate limiting + spend guard ---
# Shared secret Vercel Cron sends as `Authorization: Bearer <value>` when it
# calls /api/cron/cleanup-usage on the schedule in vercel.json. Set any long
# random string in Vercel's env vars.
CRON_SECRET=
